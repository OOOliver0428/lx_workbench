# 后端环境配置模板：复制为仓库根目录 .env，按需填写；修改后重启后端。
# 前端配置另见 frontend/.env.example，复制到 frontend/.env.local。
# 此文件只保留默认值和空凭证；真实 .env、密钥、手机号及验证码不要提交到仓库。

# ==================== 基础运行与会话 ====================
MVP_ENVIRONMENT=development
MVP_DATABASE_URL=sqlite:///./data/mvp.db
# 后端默认仅监听本机，由前端同源 /api 代理访问。
MVP_SERVER_HOST=127.0.0.1
MVP_SERVER_PORT=8787
MVP_SESSION_COOKIE_NAME=mvp_session
MVP_SESSION_TTL_HOURS=12
# 本地 HTTP 使用 false；生产 HTTPS 使用 true。
MVP_COOKIE_SECURE=false
# 浏览器访问所用的域名/IP；多项用英文逗号分隔。
MVP_ALLOWED_HOSTS_CSV=127.0.0.1,localhost
# 同源代理部署保持为空；确需跨域时填写明确的前端来源。
MVP_CORS_ORIGINS_CSV=
MVP_LOG_LEVEL=INFO
# 普通 API 请求体上限（字节），与前端 MVP_MAX_REQUEST_BODY_BYTES 保持一致。
# 头像上传路径单独允许 5 MiB + 64 KiB，文件本身仍最多 5 MiB，无需调高这里。
MVP_API_MAX_BODY_BYTES=262144

# ==================== 登录频控与失败审计 ====================
# 全局/单来源每分钟密码校验次数及同时校验数。
MVP_LOGIN_VERIFICATION_LIMIT_PER_MINUTE=120
MVP_LOGIN_SOURCE_LIMIT_PER_MINUTE=60
MVP_LOGIN_MAX_CONCURRENT_VERIFICATIONS=2
# 最多追踪的限流状态数量。
MVP_LOGIN_THROTTLE_MAX_KEYS=2048
# 失败审计每分钟写入上限、保留天数和最大条数。
MVP_LOGIN_FAILURE_AUDIT_LIMIT_PER_MINUTE=20
MVP_LOGIN_FAILURE_AUDIT_RETENTION_DAYS=90
MVP_LOGIN_FAILURE_AUDIT_MAX_ROWS=10000

# ==================== AI 调用、上下文与凭证存储 ====================
MVP_LLM_MAX_CONCURRENT_GENERATIONS=2
MVP_LLM_MAX_USER_CONCURRENT_GENERATIONS=1
MVP_LLM_USER_REQUESTS_PER_HOUR=20
MVP_LLM_USER_TOKENS_PER_DAY=100000
MVP_LLM_GLOBAL_TOKENS_PER_DAY=1000000
MVP_LLM_MAX_TRACKED_USERS=10000
# 聊天、个人周报、团队周报生成的冷却时间（秒）。
MVP_LLM_CHAT_COOLDOWN_SECONDS=2
MVP_LLM_WEEKLY_COOLDOWN_SECONDS=60
MVP_LLM_TEAM_SUMMARY_COOLDOWN_SECONDS=60
# 对话历史最多消息条数、历史字符数、单条输入字符数、业务上下文字符数。
MVP_LLM_CHAT_HISTORY_MAX_MESSAGES=24
MVP_LLM_CHAT_HISTORY_MAX_CHARS=16000
MVP_LLM_CHAT_MESSAGE_MAX_CHARS=4000
MVP_LLM_CHAT_CONTEXT_MAX_CHARS=30000
# AI Provider 凭证的加密主密钥；启用前生成独立高强度随机值（至少 32 字符）。
# 已保存 Provider 配置后必须保留原密钥，备份/迁移时单独保管，不与手机号密钥复用。
MVP_LLM_CONFIG_SECRET=
MVP_LLM_TIMEOUT_SECONDS=60
MVP_LLM_TEST_TOKEN_TTL_SECONDS=600

# MiniMax 可选环境凭证及默认模型；也可通过系统设置配置 AI Provider。
MVP_MINIMAX_API_KEY=
MVP_MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MVP_MINIMAX_MODEL=MiniMax-M2.7
# auto 按 sk-cp- 前缀识别 Token Plan；也可填写 token_plan 或 pay_as_you_go。
MVP_MINIMAX_ACCESS_MODE=auto
MVP_MINIMAX_TIMEOUT_SECONDS=60

# ==================== 可选手机号认证（v0.5.1） ====================
# 默认关闭。下方密钥、阿里云参数全部配置完成后改为 true，并重启后端。
# 不改变原有密码登录及业务权限。详细说明：docs/PHONE_VERIFICATION.md。
MVP_PHONE_VERIFICATION_ENABLED=false

# 手机号加密密钥集合：启用前自行生成独立随机 Fernet 密钥。
# 格式示意（不可直接使用）：'{"v1":"<Fernet 密钥>"}'；JSON 外层使用单引号。
# 现有号码和备份仍依赖旧密钥，不能用新值覆盖旧 ID，也不能随意删除历史密钥。
MVP_PHONE_ENCRYPTION_KEYS='{}'
# 新写入数据使用的密钥 ID，必须存在于上面的 JSON 中。
MVP_PHONE_ENCRYPTION_ACTIVE_KEY_ID=v1
# 独立随机 32 字节 URL-safe Base64 密钥，用于查询指纹、号码唯一性和频控。
# 不得复用加密密钥；已有认证数据后，轮换需要离线迁移，不能只改此值。
MVP_PHONE_LOOKUP_KEY=

# 阿里云 RAM 用户的 AccessKey，需具备验证码 2.0 校验和短信认证发送/核验权限。
# 两项只供后端使用，不能写入前端 NEXT_PUBLIC_* 配置。
MVP_ALIYUN_ACCESS_KEY_ID=
MVP_ALIYUN_ACCESS_KEY_SECRET=

# 验证码 2.0 控制台 → 概览 → 身份标 prefix。
# 这里不是“号码认证服务 → 图形认证方案管理”的 appId/appKey，两套参数不能互填。
MVP_ALIYUN_CAPTCHA_PREFIX=
# 验证码 2.0 → 场景管理 → 场景 ID（SceneId）；接入方式选 Web/H5。
# 场景须与上面 prefix 对应；当前代码使用中国内地 cn 地域。
MVP_ALIYUN_CAPTCHA_SCENE_ID=

# 号码认证服务短信认证控制台的短信签名名称。
MVP_ALIYUN_SMS_SIGN_NAME=
# 配套的短信模板编号（不是模板正文）；赠送签名须搭配赠送模板。
# 当前请求参数为 {"code":"##code##","min":"5"}，模板须支持 code/min。
MVP_ALIYUN_SMS_TEMPLATE_CODE=
# 本功能专用短信认证方案名，最多 20 个字符，避免与其他系统共用验证码空间。
MVP_ALIYUN_SMS_SCHEME_NAME=

# 发送频控：按用户、号码、全局分别限制；失败/结果不确定的发送也计数，重启不清零。
MVP_PHONE_USER_HOUR_LIMIT=5
MVP_PHONE_USER_DAY_LIMIT=10
MVP_PHONE_NUMBER_HOUR_LIMIT=5
MVP_PHONE_NUMBER_DAY_LIMIT=10
MVP_PHONE_GLOBAL_HOUR_LIMIT=100
MVP_PHONE_GLOBAL_DAY_LIMIT=500
# 验证码长度 6 位、有效期 300 秒、重发间隔 60 秒、单次认证最多提交 5 次为代码固定值。

# ==================== 可选自定义头像 / 私有 COS（v0.5.1） ====================
# 默认关闭。已绑定手机号用户可上传；不依赖短信服务实时在线。
# 配置完整后改为 true 并重启后端。详细说明：docs/CUSTOM_AVATARS.md。
MVP_CUSTOM_AVATAR_ENABLED=false
# 腾讯云专用子账号凭证，仅授予指定头像前缀的读、写、删除权限，只供后端使用。
MVP_AVATAR_COS_SECRET_ID=
MVP_AVATAR_COS_SECRET_KEY=
# 完整桶名，含 APPID，例如 your-bucket-1234567890；桶及对象保持私有读写。
MVP_AVATAR_COS_BUCKET=
# 桶所属地域，例如 ap-guangzhou，与创建桶时的地域一致。
MVP_AVATAR_COS_REGION=
# 对象键前缀，与 CAM 授权前缀一致；切换此值不会搬迁已有图片。
MVP_AVATAR_COS_PREFIX=avatars/
