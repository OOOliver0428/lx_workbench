MVP_ENVIRONMENT=development
MVP_DATABASE_URL=sqlite:///./data/mvp.db
MVP_SERVER_HOST=127.0.0.1
MVP_SERVER_PORT=8787
MVP_SESSION_COOKIE_NAME=mvp_session
MVP_SESSION_TTL_HOURS=12
MVP_COOKIE_SECURE=false
MVP_ALLOWED_HOSTS_CSV=127.0.0.1,localhost
MVP_CORS_ORIGINS_CSV=http://127.0.0.1:5174,http://localhost:5174
MVP_LOG_LEVEL=INFO
MVP_LLM_CONFIG_SECRET=
MVP_LLM_TIMEOUT_SECONDS=60
MVP_LLM_TEST_TOKEN_TTL_SECONDS=600
MVP_MINIMAX_API_KEY=
MVP_MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MVP_MINIMAX_MODEL=MiniMax-M2.7
# auto 会根据 sk-cp- 前缀识别 Token Plan；也可显式填写 token_plan 或 pay_as_you_go
MVP_MINIMAX_ACCESS_MODE=auto
MVP_MINIMAX_TIMEOUT_SECONDS=60
