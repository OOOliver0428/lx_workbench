# Runtime environment. The installer writes the active copy to
# /etc/solution-workspace/app.env with mode 0640 (root:service-account).
MVP_ENVIRONMENT=production
MVP_DATABASE_URL=sqlite:////var/lib/solution-workspace/trial.db
MVP_SERVER_HOST=127.0.0.1
MVP_SERVER_PORT=8787
MVP_SESSION_COOKIE_NAME=mvp_session
MVP_SESSION_TTL_HOURS=12
MVP_COOKIE_SECURE=false
MVP_ALLOWED_HOSTS_CSV=127.0.0.1,localhost
MVP_CORS_ORIGINS_CSV=
MVP_LOG_LEVEL=INFO

# Keep this value stable when switching databases. Losing it makes saved AI
# provider credentials unreadable.
MVP_LLM_CONFIG_SECRET=replace-with-openssl-rand-hex-32
MVP_LLM_TIMEOUT_SECONDS=60
MVP_LLM_TEST_TOKEN_TTL_SECONDS=600

# Optional migration fallback. Prefer configuring providers in the UI.
MVP_MINIMAX_API_KEY=
MVP_MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MVP_MINIMAX_MODEL=MiniMax-M2.7
MVP_MINIMAX_ACCESS_MODE=auto
MVP_MINIMAX_TIMEOUT_SECONDS=60
