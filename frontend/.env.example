# 前端配置模板：复制为 frontend/.env.local，修改后重启前端。
# 阿里云/COS 凭证、手机号加密密钥只放根目录 .env，不能放到这里。

# 浏览器 API 基地址：默认留空，使用同源 /api，确保 HttpOnly 会话 Cookie 正常工作。
# NEXT_PUBLIC_* 会进入浏览器代码，不能存放任何密钥。
NEXT_PUBLIC_API_BASE_URL=

# 前端服务端代理访问的后端地址，须与后端实际监听端口一致。
MVP_INTERNAL_API_BASE_URL=http://127.0.0.1:8787
# 普通请求体上限（字节），与后端 MVP_API_MAX_BODY_BYTES 保持一致。
# 头像上传路径单独允许 5 MiB + 64 KiB；原图文件本身仍最多 5 MiB。
MVP_MAX_REQUEST_BODY_BYTES=262144

# 仅构建预设头像素材时可通过系统环境变量传入 AVATAR_SOURCE_DIR，默认仓库根目录 .static。
# 它不是应用运行配置，node 素材脚本不会自动读取本文件。
